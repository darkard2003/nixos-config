// -*- mode: jsonc -*-
[
  {
    "layer": "top",
    "position": "top",
    "spacing": 4,
    "margin-left": 12,
    "margin-right": 12,
    "margin-top": 6,
    "height": 38,
    "include": [
      "~/.config/waybar/shared_modules.jsonc"
    ],
    "modules-left": [
      "custom/nix",
      "clock",
      "custom/weather",
      "custom/notification",
      "memory",
      "cpu",
      "disk",
      "temperature",
      "mpris"
    ],
    "modules-center": [
      "sway/workspaces",
      "sway/mode",
      "sway/scratchpad"
    ],
    "modules-right": [
      "idle_inhibitor",
      "pulseaudio",
      "custom/pi-indicator",
      "network",
      "bluetooth",
      "backlight",
      "tray",
      "battery",
      "custom/power"
    ],
    "sway/workspaces": {
      "disable-scroll": true,
      "all-outputs": true,
      "warp-on-scroll": false,
      "format": "{icon}",
      "persistent-workspaces": {
        "1": [],
        "2": [],
        "3": []
      },
      "format-icons": {
        "1": " ",
        "2": " ",
        "3": " ",
        "4": " ",
        "5": "󰎱",
        "6": "󰎳",
        "7": "󰎶",
        "8": "󰎹",
        "9": "󰎼",
        "urgent": " ",
        "default": ""
      }
    }
  }
]
