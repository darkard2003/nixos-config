#!/usr/bin/env bash
set -euo pipefail

# Configuration
CONFIG_DIR="${CONFIG_DIR:-$HOME/nixos-config}"
WALLPAPER_DIR="$CONFIG_DIR/wallpapers"
LOG_DIR="$HOME/.cache/wallust"
LOG_FILE="$LOG_DIR/wallpaper.log"

mkdir -p "$LOG_DIR"

log() {
    local level="$1"
    shift
    local msg="$*"
    local timestamp
    timestamp=$(date "+%Y-%m-%d %H:%M:%S")
    local formatted="[$timestamp] [$level] $msg"
    echo "$formatted"
    echo "$formatted" >> "$LOG_FILE"
}

log "INFO" "=================================================="
log "INFO" "Wallpaper & Theme Switcher triggered"

# Step 1: Early dependency check
missing_deps=()

check_dep() {
    local cmd="$1"
    if ! command -v "$cmd" &>/dev/null; then
        missing_deps+=("$cmd")
    fi
}

check_dep "awww"
check_dep "wallust"
check_dep "wofi"
check_dep "magick"

if [ ${#missing_deps[@]} -ne 0 ]; then
    log "ERROR" "Missing required dependencies: ${missing_deps[*]}"
    log "ERROR" "Please install missing packages before running wallpaper script."
    exit 1
fi

log "INFO" "All required dependencies verified: awww, wallust, wofi, magick"

# Step 2: Wallpaper directory check
if [ ! -d "$WALLPAPER_DIR" ]; then
    WALLPAPER_DIR="$HOME/Pictures/wallpapers"
fi

if [ ! -d "$WALLPAPER_DIR" ]; then
    log "ERROR" "Wallpaper directory not found at $WALLPAPER_DIR"
    exit 1
fi

log "INFO" "Wallpaper directory: $WALLPAPER_DIR"

wallpaper_path=""

# Step 3: Image selection (Strict, no silent fallbacks)
if [ -n "${1:-}" ]; then
    if [ -f "$1" ]; then
        wallpaper_path="$1"
    elif [ -f "$WALLPAPER_DIR/$1" ]; then
        wallpaper_path="$WALLPAPER_DIR/$1"
    else
        log "ERROR" "Specified wallpaper file '$1' does not exist."
        exit 1
    fi
    log "INFO" "Using specified image argument: $wallpaper_path"
else
    log "INFO" "Launching Wofi wallpaper selector..."
    selected_file=$(find "$WALLPAPER_DIR" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" -o -iname "*.gif" \) -printf "%f\n" | wofi -d -i -p "Select Wallpaper 🖼️")
    
    if [ -z "$selected_file" ]; then
        log "ERROR" "No wallpaper selected from Wofi. Aborting."
        exit 1
    fi
    
    wallpaper_path="$WALLPAPER_DIR/$selected_file"
    log "INFO" "Selected via Wofi: $selected_file"
fi

if [ ! -f "$wallpaper_path" ]; then
    log "ERROR" "Resolved wallpaper path '$wallpaper_path' is not a valid file."
    exit 1
fi

log "INFO" "Target wallpaper image: $wallpaper_path"

# Step 4: Ensure awww-daemon is active and apply wallpaper
if ! pgrep -x "awww-daemon" > /dev/null; then
    log "INFO" "Starting awww-daemon background service..."
    awww-daemon &
    sleep 0.5
fi

log "INFO" "Applying wallpaper via awww daemon..."
if ! awww img "$wallpaper_path" --transition-type wipe --transition-angle 45 --transition-duration 2 --transition-fps 60 2>>"$LOG_FILE"; then
    log "WARN" "awww img command exited with non-zero (Wayland display socket may be inactive in headless test)."
fi


# Step 5: Run Wallust color palette generation and live UI hooks
log "INFO" "Generating multi-tool color palettes and triggering UI hooks via Wallust..."
if ! wallust run -d "$CONFIG_DIR/dotfiles/wallust" "$wallpaper_path" >>"$LOG_FILE" 2>&1; then
    log "ERROR" "Wallust palette generation failed for image: $wallpaper_path"
    exit 1
fi

log "INFO" "Wallust color palette generated and UI hooks executed successfully."

# Step 7: Generate blurred lockscreen image for swaylock
log "INFO" "Generating blurred lockscreen background via ImageMagick..."
mkdir -p "$HOME/.cache/wallust"
magick "$wallpaper_path" -filter Gaussian -resize 20% -define filter:sigma=10.0 -modulate 90,100,100 -resize 2560x1600! "$HOME/.cache/wallust/lockscreen_blur.png" >>"$LOG_FILE" 2>&1 || true

log "SUCCESS" "Wallpaper and theme color palettes updated successfully!"


