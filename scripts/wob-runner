#!/usr/bin/env bash
set -euo pipefail

WOBSOCK="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/wob.sock"

# Re-create FIFO
rm -f "$WOBSOCK"
mkfifo "$WOBSOCK"

# Locate config file (wallust generated or default)
CONFIG_FILE="$HOME/.cache/wallust/wob.ini"
if [ ! -f "$CONFIG_FILE" ]; then
    CONFIG_FILE="$HOME/.config/wob/wob.ini"
fi
if [ ! -f "$CONFIG_FILE" ]; then
    CONFIG_FILE="$HOME/nixos-config/dotfiles/wob/wob.ini"
fi

# Run tail piped into wob
tail -f "$WOBSOCK" | wob -c "$CONFIG_FILE"
